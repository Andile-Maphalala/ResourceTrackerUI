@using MudBlazor.Charts
@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Domain.Models.Feature.BuildPlan
@using ResourceTrackerUI.Domain.Models.Feature.BuildPlanRequirement
<MudPaper Class="doc-section-component-container">
    <MudChart T="int" ChartType="ChartType.Sankey" Width="@($"{_width}px")" Height="@($"{_height}px")" ChartSeries="@_series" ChartOptions="@_options" />
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudSlider @bind-Value="_options.NodeWidth" Max="50" ValueLabel="true">Node width</MudSlider>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSlider @bind-Value="_options.MinVerticalSpacing" Max="30" ValueLabel="true">Min. vertical spacing</MudSlider>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSlider @bind-Value="_options.EdgeOpacity" Step="0.01" Max="1" ValueLabel="true">Edge opacity</MudSlider>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudSlider @bind-Value="_width" ValueLabel="true" Max="2000">Chart width</MudSlider>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudSlider @bind-Value="_height" ValueLabel="true" Max="2000">Chart height</MudSlider>
    </MudItem>
</MudGrid>

@if (_stations.Any())
{
    <MudSimpleTable Dense="true" Class="mt-3">
        <thead>
            <tr><th>Component</th><th>Crafted At</th></tr>
        </thead>
        <tbody>
            @foreach (var s in _stations)
            {
                <tr><td>@s.ComponentName</td><td>@s.FacilityName</td></tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter]
    public BuildPlanModel Model { get; set; }
    [Parameter]
    public Func<bool, Task<GetBuildPlanSankeyResponseModel>>? GetData { get; set; }


    private List<ChartSeries<int>> _series = new();
    private List<ComponentFacilityModel> _stations = new();
    private readonly SankeyChartOptions _options = new()
    {
        ShowLabels = true,
        ShowNodeValues = false,
        HighlightOnHover = true,
        NodeWidth = 5,
        MinVerticalSpacing = 10,
    };
    private int _width = 1500;
    private int _height = 550;
    protected override async Task OnInitializedAsync()
    {
        var response = await GetData!(false);
        var sankeyData = response.Edges
                    .Select(e => new SankeyEdge<int>(e.Source, e.Target, e.Value))
                    .ToList();
        _series = new List<ChartSeries<int>>
        {
            new()
            {
                Name = response.BuildPlanName,
                Data = sankeyData
            }
        };

        _stations = response.CraftingStations;
    }

}
