
@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Domain.Models.Feature.BuildPlan
@using ResourceTrackerUI.Shared.CustomComponents
@using ResourceTrackerUI.Shared.CustomComponents.FormControls


@page "/buildplandetails/{BuildPlanId:int}"

    <HeaderComponent Name="@_model.Name" Description="@_model.Description" ChipName="@_model.GameSaveName" />
    <RtToggle Option1Name="SETUP" Option1Event='() => SetView("setup")' Option2Name="OVERVIEW" Option2Event='() => SetView("overview")' />



<MudTabs Elevation="1" Rounded="true" @ref="_tabs">
    <MudTabPanel Text="SETUP" ID="@("setup")" >
        <BuildPlanDetailsSetup BuildPlanId="@BuildPlanId" />
    </MudTabPanel>
    <MudTabPanel Text="OVERVIEW" ID="@("overview")" >
        <BuildPlanDetailsOverview BuildPlanId="@BuildPlanId" />
    </MudTabPanel>
</MudTabs>

@code {

    [Parameter]
    public int BuildPlanId { get; set; }

    [Inject]
    private IBuildPlanService BuildPlanService { get; set; }

    private BuildPlanModel _model { get; set; } = new BuildPlanModel();
    private string _view = "location";
    private MudTabs _tabs = null!;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBuildPlan();
        }
    }


    private async Task SetView(string view)
    {
        await _tabs.ActivatePanelAsync(view);
    }

    private async Task LoadBuildPlan()
    {
        var response = await BuildPlanService.GetBuildPlan(BuildPlanId, appCancellation.Token);
        if (response != null)
        {
            _model = response;
            StateHasChanged();
        }
    }
   
}
