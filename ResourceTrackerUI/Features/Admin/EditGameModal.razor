@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Shared.CustomComponents.FormControls
@using ResourceTrackerUI.Domain.Enums
@using ResourceTrackerUI.Domain.Models.Feature
@using System.Text.Json
@using ResourceTrackerUI.Domain.Models.Feature.Game


<RtForm TModel="GameModel" Model="Model" FormMode="FormMode" OnSubmit="Submit" OnCancel="Cancel"
        DeleteMessage="Are you sure you want to delete this game?">
    <ChildContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <RtInput @bind-Value="Model.Name" For="@(() => Model.Name)"/>
                <RtInput @bind-Value="Model.AltText"
                              For="@(() => Model.AltText)"
                              Disabled = "@(FormMode != FormModeEnum.Create)"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <RtInput @bind-Value="Model.Description" For="@(() => Model.Description)" Lines="5"
                              />
            </MudItem>

            <MudItem xs="12" sm="12">
                <MudGrid>
                    <MudItem xs="12" sm="9" Style="height:500px;">
                        <MudImage     Src="@_base64"
                                      Alt="@Model.AltText"
                                      Height="400"
                                      Width="350"
                                      Elevation="25"
                                      Class="rounded-lg"
                                      ObjectFit="@ObjectFit.Fill" />

                    </MudItem>
                    <MudItem xs="12" sm="3">
                            <MudFileUpload @bind-Files="@Model.Image"
                                           OnFilesChanged="@SwapPicture"
                                           Accept=".jpg,.bmp,.tiff,.jpeg,.png">
                            </MudFileUpload>
                        <MudButton ButtonType="ButtonType.Button" OnClick="ClearImage"> </MudButton>
                        <MudButton OnClick="ClearImage"
                                   Variant="Variant.Filled">
                            Clear Image
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>

        </MudGrid>
    </ChildContent>
    <FooterContent>
        @if (FormMode == FormModeEnum.Delete)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1" Color="Color.Error">Purge game</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Deletes the game and everything attached to it: components, recipes, inventory,
                quests, game saves, build plans, player facilities and stored images. This cannot
                be undone and is intended for clearing test data.
            </MudText>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                Type <b>@Model.Name</b> exactly to enable the purge.
            </MudAlert>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <RtInput T="string"
                         @bind-Value="_confirmName"
                         Label="Game name"
                         Disabled="@_isPurging" />
                <MudButton Color="Color.Error"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           Disabled="@(!CanPurge)"
                           OnClick="Purge">
                    Purge
                </MudButton>
            </MudStack>
        }
    </FooterContent>
</RtForm>


