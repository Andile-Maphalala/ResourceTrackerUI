@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Avoid a redirect loop if this ever renders on the login page itself.
        if (relativePath.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var returnUrl = "/" + relativePath;
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
    }
}
