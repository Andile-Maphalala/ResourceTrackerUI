@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using System.Reflection
@using MudExtensions
@using ResourceTrackerUI.Domain.Attributes
@using ResourceTrackerUI.Domain.Common
@inherits MudSelectExtended<T>
@typeparam T

<MudSelectExtended T="T"
           Value="@this.Value"
           ValueChanged="OnValueChangedHandler"
           Text="@_displayText"
           SelectedValues="@this.SelectedValues"
           SelectedValuesChanged="@this.SelectedValuesChanged"
           Label="@this.Label"
           For="@this.For"
           Required="@this.Required"
           Disabled="@this.Disabled"
           Variant="@this.Variant"
           Margin="@this.Margin"
           Class="@this.Class"
           Style="@this.Style"
           Adornment="@this.Adornment"
           AdornmentIcon="@this.AdornmentIcon"
           AdornmentColor="@this.AdornmentColor"
           AdornmentText="@this.AdornmentText"
           OnAdornmentClick="@this.OnAdornmentClick"
           Clearable="@this.Clearable"
           ReadOnly="@this.ReadOnly"
           Placeholder="@this.Placeholder"
           HelperText="@this.HelperText"
           Error="@this.Error"
           ErrorText="@this.ErrorText"
           Dense="@this.Dense"
           FullWidth="@this.FullWidth"
           TextChanged="@this.TextChanged"
           Pattern="@this.Pattern"
           AdornmentAriaLabel="@this.AdornmentAriaLabel"
           AnchorOrigin="@this.AnchorOrigin"
           AutoFocus="@this.AutoFocus"
           CheckedIcon="@this.CheckedIcon"
           CloseIcon="@this.CloseIcon"
           Comparer="@this.Comparer"
           Converter="@this.Converter"
           Counter="@this.Counter"
           Culture="@this.Culture"
           Delimiter="@this.Delimiter"
           ErrorChanged="@this.ErrorChanged"
           ErrorId="@this.ErrorId"
           ErrorIdChanged="@this.ErrorIdChanged"
           ErrorTextChanged="@this.ErrorTextChanged"
           Format="@this.Format"
           HelperId="@this.HelperId"
           HelperTextOnFocus="@this.HelperTextOnFocus"
           IconSize="@this.IconSize"
           Immediate="@this.Immediate"
           IndeterminateIcon="@this.IndeterminateIcon"
           InputClass="@this.InputClass"
           InputId="@this.InputId"
           InputMode="@this.InputMode"
           KeyDownPreventDefault="@this.KeyDownPreventDefault"
           KeyUpPreventDefault="@this.KeyUpPreventDefault"
           Lines="@this.Lines"
           LockScroll="@this.LockScroll"
           MaxHeight="@this.MaxHeight"
           MaxLength="@this.MaxLength"
           Modal="@this.Modal"
           MultiSelection="@this.MultiSelection"
           MultiSelectionTextFunc="@this.MultiSelectionTextFunc"
           OnBlur="@this.OnBlur"
           OnClearButtonClick="@this.OnClearButtonClick"
           OnInternalInputChanged="@this.OnInternalInputChanged"
           OnKeyDown="@this.OnKeyDown"
           OnKeyUp="@this.OnKeyUp"
           OnlyValidateIfDirty="@this.OnlyValidateIfDirty"
           OpenIcon="@this.OpenIcon"
           PopoverClass="@this.PopoverClass"
           RelativeWidth="@this.RelativeWidth"
           RequiredError="@this.RequiredError"
           SelectAll="@this.SelectAll"
           SelectAllText="@this.SelectAllText"
           ShrinkLabel="@this.ShrinkLabel"
           Strict="@this.Strict"
           Tag="@this.Tag"
           TransformOrigin="@this.TransformOrigin"
           Typo="@this.Typo"
           UncheckedIcon="@this.UncheckedIcon"
           Underline="@this.Underline"
           UserAttributes="@this.UserAttributes"
           Validation="@this.Validation"
           AddedNullItemText="@this.AddedNullItemText"
           AddNullItem="@this.AddNullItem"
           AdornmentEnd="@this.AdornmentEnd"
           AdornmentStart="@this.AdornmentStart"
           OnOpen="@this.OnOpen"
           OnClose="@this.OnClose"
           OnChange="@this.OnChange"
           ItemCollection="@_itemValues"
           SearchBox="@this.EnableSearch"
           SearchBoxPlaceholder="@this.SearchPlaceholder"
           SearchFunc="@SearchFilter"
           OnSearchStringChange="OnSearchStringChanged"
           Virtualize="@EnableVirtualize"
           ToStringFunc="@GetItemText"
            >

    <ItemTemplate Context="ctx">
        @{
            var item = _dataList.FirstOrDefault(x => EqualityComparer<T>.Default.Equals(x.Value, ctx.Value));
        }
        @if (_isLoading)
        {
            <MudSkeleton />
        }
        else
        {
            <MudStack Row="false" Class="mud-width-full" Spacing="0">
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="py-2">
                    @if (EnableImages && item != null && !string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <div style="width:64px;height:40px;border-radius:6px;overflow:hidden;flex-shrink:0;">
                            <img src="@item.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                    }
                    <MudText Typo="Typo.body1">@(item?.Text ?? ctx.Value?.ToString())</MudText>
                </MudStack>
                <MudDivider Class="mt-1" />
            </MudStack>
        }
    </ItemTemplate>
</MudSelectExtended>

    @code {
    [Parameter]
    public Func<Task<IEnumerable<object>>> LoadData { get; set; }

    [Parameter]
    public EventCallback<T> OnValueChangedData { get; set; }

    [Parameter]
    public EventCallback OnValueChanged { get; set; }

    [Parameter]
    public string ValueField { get; set; } = "Id";

    [Parameter]
    public string TextField { get; set; } = "Name";

    [Parameter]
    public string ImageField { get; set; } = "ImageUrl";

    [Parameter]
    public bool EnableImages { get; set; } = false;

    [Parameter]
    public bool EnableSearch { get; set; } = false;

    /// <summary>
    /// Placeholder shown in the search box when <see cref="EnableSearch"/> is on.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>
    /// Optional server-side search. When set, every change of the search box calls this with the
    /// typed text and replaces the options with the result. Use it for lists too large to load
    /// in one go - pair it with a small PageSize in the caller.
    /// </summary>
    [Parameter]
    public Func<string, Task<IEnumerable<object>>>? SearchData { get; set; }

    /// <summary>
    /// When <see cref="SearchData"/> does the searching the list must not filter again: the server
    /// may match on fields that are not part of the display text (the description, for one), and a
    /// second "contains" pass over the label would hide results the server just returned.
    /// </summary>
    private Func<T?, string?, bool>? SearchFilter => SearchData is null ? null : AlwaysMatch;

    private static bool AlwaysMatch(T? value, string? searchString) => true;

    /// <summary>
    /// Debounce applied before <see cref="SearchData"/> is called, in milliseconds.
    /// </summary>
    [Parameter]
    public int SearchDebounceMs { get; set; } = 300;

    /// <summary>
    /// Only renders the visible items. Costs nothing for small lists and is what keeps large
    /// ones (thousands of components) from locking up the browser. Requires ItemCollection,
    /// which this component always supplies.
    /// </summary>
    [Parameter]
    public bool EnableVirtualize { get; set; } = true;

    private List<SelectListModel<T>> _dataList = new List<SelectListModel<T>>();

    /// <summary>
    /// The options handed to <see cref="MudSelectExtended{T}"/>. This is deliberately one stable
    /// instance that only ever gets cleared and refilled: a select hosts its list component with a
    /// parameter freeze (CodeBeam issue #645), so the list keeps the collection instance it was
    /// created with and ignores every later parameter update. Replacing the list would leave an
    /// open dropdown showing the old options - which is why a server-side search only "worked"
    /// after closing and reopening it. Mutating this instance in place is what lets the results
    /// reach an already open list.
    /// </summary>
    private readonly List<T> _itemValues = new();
    private bool _dataLoaded = false;
    private bool _isLoading = false;
    private string _displayText;
    private bool _isInitialized = false;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (For != null)
        {
            var member = (For.Body as MemberExpression)?.Member;
            if (member != null)
            {
                var attr = member.GetCustomAttribute<FormFieldAttribute>();

                if (string.IsNullOrEmpty(Label))
                {
                    Label = attr?.DisplayName ?? member.Name;
                }

                if (string.IsNullOrEmpty(Placeholder))
                {
                    Placeholder = attr?.Placeholder;
                }

                Required = member.GetCustomAttribute<RequiredAttribute>() != null;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && LoadData != null && !_dataLoaded && !_isLoading)
        {
            await LoadSelectData();
            UpdateDisplayText();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateDisplayText()
    {
        if (_dataLoaded && Value != null)
        {
            var selectedItem = _dataList.FirstOrDefault(x =>
                EqualityComparer<T>.Default.Equals(x.Value, Value));
            if (selectedItem != null)
            {
                _displayText = selectedItem.Text;
            }
        }
        else if (Value != null)
        {
            _displayText = Value.ToString();
        }
        else
        {
            _displayText = string.Empty;
        }
    }

    private async Task OnValueChangedHandler(T value)
    {
        Value = value;
        UpdateDisplayText();

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(value);
        }

        if (OnValueChanged.HasDelegate)
        {
            await OnValueChanged.InvokeAsync(value);
        }
    }

    private void OnTextChanged(string text)
    {
    }

    private async Task BuildDataList()
    {
        if (LoadData == null)
            return;

        var Data = await LoadData.Invoke();
        ApplyData(Data);
    }

    private void ApplyData(IEnumerable<object> data)
    {
        // Keep the entry for the current value: when the caller pages or searches, the selected
        // item is often not in the new result set, and dropping it would blank the display.
        var selected = _dataList.FirstOrDefault(x => EqualityComparer<T>.Default.Equals(x.Value, Value));

        var list = data.Select(item => new SelectListModel<T>
        {
            Value = GetPropertyValue<T>(item, ValueField),
            Text = GetPropertyValue<string>(item, TextField),
            ImageUrl = GetPropertyValue<string>(item, ImageField)
        }).ToList();

        if (selected != null && !list.Any(x => EqualityComparer<T>.Default.Equals(x.Value, Value)))
        {
            list.Insert(0, selected);
        }

        _dataList = list;

        // Refill in place - see the comment on _itemValues.
        _itemValues.Clear();
        _itemValues.AddRange(list.Select(x => x.Value));

        _dataLoaded = true;
    }

    private async Task OnSearchStringChanged(string searchString)
    {
        if (SearchData == null)
            return;

        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        try
        {
            await Task.Delay(SearchDebounceMs, cts.Token);

            var data = await SearchData(searchString ?? string.Empty);

            if (cts.IsCancellationRequested)
                return;

            ApplyData(data);
            UpdateDisplayText();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke.
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                _searchCts = null;
            }

            cts.Dispose();
        }
    }

    private TProperty GetPropertyValue<TProperty>(object item, string propertyName)
    {
        if (string.IsNullOrEmpty(propertyName))
            return default;

        var property = item.GetType().GetProperty(propertyName);
        if (property == null)
            return default;

        var value = property.GetValue(item);

        if (value == null)
            return default;

        return (TProperty)value;
    }
    private async Task LoadSelectData()
    {
        if (_isLoading)
            return;

        _isLoading = true;

        try
        {
            await BuildDataList();
            UpdateDisplayText();
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task RefreshData()
    {
        _dataLoaded = false;
        await LoadSelectData();
        StateHasChanged();
    }

    private string GetItemText(T? value)
        => _dataList.FirstOrDefault(x => EqualityComparer<T>.Default.Equals(x.Value, value))?.Text
           ?? value?.ToString();
}