@using ResourceTrackerUI.Domain.Common.CustomComponents
<div class="flex items-center gap-1 bg-surface-container-low rounded-lg p-1 w-fit mb-lg">
    @foreach (var option in Options)
    {
        <button @onclick="() => SelectOption(option)"
                class="@GetButtonClass(option)">
            @option.Name
        </button>
    }
</div>

@code {

    [Parameter]
    public List<RtToggleOptionModel> Options { get; set; } = [];

    private string? selectedOption;

    protected override void OnParametersSet()
    {
        if (selectedOption == null && Options.Count > 0)
            selectedOption = Options[0].Value;
    }

    private async Task SelectOption(RtToggleOptionModel option)
    {
        selectedOption = option.Value;

        if (option.OnSelected.HasDelegate)
            await option.OnSelected.InvokeAsync();
    }

    private string GetButtonClass(RtToggleOptionModel option)
    {
        var baseClasses = "px-5 py-2 rounded font-label-caps text-label-caps transition-colors";
        var activeClasses = "bg-primary text-on-primary";
        var inactiveClasses = "text-on-surface-variant hover:text-primary";

        return option.Value == selectedOption
            ? $"{baseClasses} {activeClasses}"
            : $"{baseClasses} {inactiveClasses}";
    }
}