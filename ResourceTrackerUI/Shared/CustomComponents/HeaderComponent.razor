<div class="flex items-center justify-between mb-lg">
    <div>
        <div class="flex items-center gap-3">
            <h1 class="font-h1 text-h1">@Name</h1>
            <span class="text-[10px] font-label-caps text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-full">
                @ChipName
            </span>
        </div>
        <p class="text-body-sm text-on-surface-variant mt-1">@Description</p>
    </div>
</div>

@code {

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public string Description { get; set; }

    [Parameter]
    public string ChipName { get; set; }

}
