@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject GameSaveState GameSaveState
@inject NavigationManager Navigation

@if (!IsAuthenticated)
{
    @* ── Not logged in: hero ── *@
    <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4">
        <h1 class="font-h1 text-h1 text-primary mb-4">RESOURCE_CORE</h1>
        <p class="text-on-surface-variant text-body max-w-md mb-8">
            Track resources, plan builds, and manage facilities across all your game saves.
        </p>
        <a href="/login"
               class="px-8 py-3 bg-primary text-on-primary font-label-caps text-label-caps
            rounded hover:opacity-90 active:scale-95 transition-all">
            GET STARTED
        </a>
    </div>
}
else if (!GameSaveState.HasActiveSave)
{
    @* ── Logged in, no save ── *@
    <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4">
        <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">save</span>
        <h2 class="font-h2 text-h2 mb-2">No active save</h2>
        <p class="text-on-surface-variant text-body max-w-sm mb-8">
            Create your first game save to start tracking resources and build plans.
        </p>
        <a href="/gamesave/create"
               class="px-8 py-3 bg-primary text-on-primary font-label-caps text-label-caps
            rounded hover:opacity-90 active:scale-95 transition-all">
            CREATE A SAVE
        </a>
        <a href="/gamesave"
               class="mt-3 text-primary text-body-sm hover:underline">
            or browse existing saves
        </a>
    </div>
}
else
{
    @* ── Has active save: dashboard ── *@
    <div class="max-w-6xl mx-auto space-y-8">
        <div>
            <h1 class="font-h1 text-h1 text-on-surface">@GameSaveState.ActiveSaveName</h1>
            <p class="text-on-surface-variant text-body">@GameSaveState.ActiveGameName</p>
        </div>

        @* Quick stats grid — wire to your real data *@
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="glass-panel p-6 rounded-xl text-center">
                <p class="font-label-caps text-label-caps text-on-surface-variant">BUILD PLANS</p>
                <p class="font-h1 text-h1 text-primary mt-1">—</p>
            </div>
            <div class="glass-panel p-6 rounded-xl text-center">
                <p class="font-label-caps text-label-caps text-on-surface-variant">INVENTORY</p>
                <p class="font-h1 text-h1 text-primary mt-1">—</p>
            </div>
            <div class="glass-panel p-6 rounded-xl text-center">
                <p class="font-label-caps text-label-caps text-on-surface-variant">FACILITIES</p>
                <p class="font-h1 text-h1 text-primary mt-1">—</p>
            </div>
            <div class="glass-panel p-6 rounded-xl text-center">
                <p class="font-label-caps text-label-caps text-on-surface-variant">MISSING</p>
                <p class="font-h1 text-h1 text-error mt-1">—</p>
            </div>
        </div>

        @* Shortcuts *@
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/buildplans" class="glass-panel p-6 rounded-xl hover:border-primary/40 transition-all group">
                <span class="material-symbols-outlined text-primary text-3xl">construction</span>
                <h3 class="font-h3 text-h3 mt-3 group-hover:text-primary transition-colors">Build Plans</h3>
                <p class="text-body-sm text-on-surface-variant mt-1">View active crafting plans</p>
            </a>
            <a href="/inventory" class="glass-panel p-6 rounded-xl hover:border-primary/40 transition-all group">
                <span class="material-symbols-outlined text-primary text-3xl">inventory</span>
                <h3 class="font-h3 text-h3 mt-3 group-hover:text-primary transition-colors">Inventory</h3>
                <p class="text-body-sm text-on-surface-variant mt-1">Check what you have</p>
            </a>
            <a href="/resourcemap" class="glass-panel p-6 rounded-xl hover:border-primary/40 transition-all group">
                <span class="material-symbols-outlined text-primary text-3xl">map</span>
                <h3 class="font-h3 text-h3 mt-3 group-hover:text-primary transition-colors">Resource Map</h3>
                <p class="text-body-sm text-on-surface-variant mt-1">Find what you need</p>
            </a>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool IsAuthenticated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            IsAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
        }
        GameSaveState.OnChange += StateHasChanged;
    }
}