@page "/gamesave"
@using Microsoft.AspNetCore.Authorization
@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Application.Services
@using ResourceTrackerUI.Components.CustomComponents.FormData
@using ResourceTrackerUI.Components.PageComponents
@using ResourceTrackerUI.Domain.Models.Feature.Game
@using ResourceTrackerUI.Domain.Models.Feature.GameSave
@attribute [Authorize]

<div class="max-w-5xl mx-auto space-y-8">

    @* ── Header ── *@
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-h2 text-h2 text-on-surface">Game Saves</h1>
            <p class="text-body-sm text-on-surface-variant mt-1">
                Manage your saves across all games
            </p>
        </div>
        <button @onclick="OpenCreateModal"
                class="flex items-center gap-2 px-5 py-2.5 bg-primary text-on-primary
            font-label-caps text-label-caps rounded
            hover:opacity-90 active:scale-95 transition-all">
            <span class="material-symbols-outlined text-sm">add</span>
            NEW SAVE
        </button>
    </div>

    @* ── Loading ── *@
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @* ── No games state ── *@
    @if (!_isLoading && !_games.Any())
    {
        <div class="glass-panel rounded-xl p-12 text-center">
            <span class="material-symbols-outlined text-5xl text-on-surface-variant">
                sports_esports
            </span>
            <p class="text-body text-on-surface-variant mt-4">No games found.</p>
        </div>
    }

    @* ── One section per game ── *@
    @foreach (var game in _games)
    {
        <div class="glass-panel rounded-xl overflow-hidden">

            @* Game header row *@
            <div class="flex items-center gap-4 p-5 border-b border-white/5 cursor-pointer
                hover:bg-white/5 transition-colors"
                 @onclick="() => ToggleGame(game.Id)">
                @if (!string.IsNullOrEmpty(game.ImageUrl))
                {
                    <img src="@game.ImageUrl" alt="@game.Name"
                         class="w-12 h-12 rounded object-cover flex-shrink-0" />
                }
                else
                {
                    <div class="w-12 h-12 rounded bg-surface-container flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-on-surface-variant">
                            sports_esports
                        </span>
                    </div>
                }

                <div class="flex-1 min-w-0">
                    <p class="font-bold text-on-surface">@game.Name</p>
                    <p class="text-body-sm text-on-surface-variant truncate">@game.Description</p>
                </div>

                <span class="material-symbols-outlined text-on-surface-variant transition-transform duration-200
                    @(_expandedGameIds.Contains(game.Id) ? "rotate-180" : "")">
                    expand_more
                </span>
            </div>

            @* Saves for this game — shown when expanded *@
            @if (_expandedGameIds.Contains(game.Id))
            {
                <div class="p-5">
                    @if (_loadingSaveIds.Contains(game.Id))
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (_savesPerGame.TryGetValue(game.Id, out var saves) && saves.Any())
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var save in saves)
                            {
                                var isActive = save.Id == GameSaveState.ActiveGameSaveId;
                                <div class="rounded-xl p-4 border transition-all
                                    @(isActive
                                                                             ? "border-primary/60 bg-primary/5"
                                                                             : "border-white/10 bg-surface-container hover:border-primary/30")">

                                    <div class="flex justify-between items-start mb-3">
                                        <div class="min-w-0 flex-1">
                                            <p class="font-bold text-on-surface truncate">@save.Name</p>
                                            <p class="text-body-sm text-on-surface-variant">
                                                @save.Created.ToShortDateString()
                                            </p>
                                        </div>
                                        @if (isActive)
                                        {
                                            <span class="ml-2 px-2 py-0.5 bg-primary/20 text-primary
                                                font-label-caps text-[10px] rounded-full flex-shrink-0">
                                                ACTIVE
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(save.Description))
                                    {
                                        <p class="text-body-sm text-on-surface-variant mb-3 line-clamp-2">
                                            @save.Description
                                        </p>
                                    }

                                    @* Actions *@
                                    <div class="flex items-center gap-2 mt-3 pt-3 border-t border-white/5">
                                        @if (!isActive)
                                        {
                                            <button @onclick="() => SetActiveSave(save, game)"
                                                    class="flex-1 py-1.5 bg-primary/10 text-primary
                                                font-label-caps text-[10px] rounded
                                                hover:bg-primary/20 transition-colors">
                                                SET ACTIVE
                                            </button>
                                        }
                                        <button @onclick="() => OpenEditModal(save, game)"
                                                class="p-1.5 text-on-surface-variant hover:text-primary
                                            transition-colors rounded hover:bg-white/5">
                                            <span class="material-symbols-outlined text-sm">edit</span>
                                        </button>
                                        <button @onclick="() => OpenDeleteModal(save, game)"
                                                class="p-1.5 text-on-surface-variant hover:text-error
                                            transition-colors rounded hover:bg-white/5">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </div>
                                </div>
                            }

                            @* Add save card *@
                            <button @onclick="() => OpenCreateModalForGame(game)"
                                    class="rounded-xl p-4 border border-dashed border-white/20
                                hover:border-primary/40 hover:bg-primary/5 transition-all
                                flex flex-col items-center justify-center gap-2 min-h-[120px]
                                text-on-surface-variant hover:text-primary">
                                <span class="material-symbols-outlined">add_circle</span>
                                <span class="font-label-caps text-[10px]">ADD SAVE</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-6">
                            <p class="text-body-sm text-on-surface-variant mb-4">
                                No saves yet for this game.
                            </p>
                            <button @onclick="() => OpenCreateModalForGame(game)"
                                    class="px-4 py-2 border border-primary/30 text-primary
                                font-label-caps text-label-caps rounded
                                hover:bg-primary/10 transition-colors">
                                CREATE FIRST SAVE
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }

</div>