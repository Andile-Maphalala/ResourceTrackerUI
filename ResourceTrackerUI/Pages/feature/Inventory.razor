@page "/inventory"
@using Microsoft.AspNetCore.Authorization
@using ResourceTrackerUI.Components.PageComponents.feature.Inventory
@attribute [Authorize]

<div class="max-w-6xl mx-auto space-y-8">

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-h2 text-h2 text-on-surface">Inventory</h1>
            <p class="text-body-sm text-on-surface-variant mt-1">
                @GameSaveState.ActiveSaveName · @GameSaveState.ActiveGameName
            </p>
        </div>
        <div class="flex items-center gap-3">
            @* View toggle *@
            <div class="flex items-center glass-panel rounded-xl p-1">
                <button @onclick='() => SetView("location")'
                        class="px-4 py-1.5 rounded-lg font-label-caps text-label-caps transition-all
                    @(_view == "location"
                                                ? "bg-primary text-on-primary"
                                                : "text-on-surface-variant hover:text-primary")">
                    BY LOCATION
                </button>
                <button @onclick='() => SetView("aggregate")'
                        class="px-4 py-1.5 rounded-lg font-label-caps text-label-caps transition-all
                    @(_view == "aggregate"
                                                ? "bg-primary text-on-primary"
                                                : "text-on-surface-variant hover:text-primary")">
                    TOTALS
                </button>
            </div>
            <button @onclick="() => OpenCreateQuestModal()"
                    class="flex items-center gap-2 px-5 py-2.5 bg-primary text-on-primary
                font-label-caps text-label-caps rounded
                hover:opacity-90 active:scale-95 transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
                NEW LOCATION
            </button>
        </div>
    </div>

    @* ── Quick stats ── *@
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <ValueComponent  Value="@_quests.Count" Description="LOCATIONS"/>
        <ValueComponent Value="@_aggregated.Count" Description="UNIQUE ITEMS" />
        <ValueComponent Value="@_aggregated.Sum(x => x.TotalQuantity)" Description="TOTAL UNITS" />
        <ValueComponent Value="@_totalItemsLoaded" Description="ITEMS LOADED" />
    </div>

    @* ── Loading ── *@
    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @* ══════════════════════════════════════
       VIEW 1: BY LOCATION
    ══════════════════════════════════════ *@
    @if (_view == "location")
    {
        @if (!_isLoading && !_quests.Any())
        {
            <div class="glass-panel rounded-xl p-16 text-center">
                <span class="material-symbols-outlined text-5xl text-on-surface-variant">
                    location_off
                </span>
                <p class="text-body text-on-surface-variant mt-4 mb-6">
                    No locations yet. Create one to start tracking resources.
                </p>
                <button @onclick="OpenCreateQuestModal"
                        class="px-6 py-2.5 bg-primary text-on-primary font-label-caps
                    text-label-caps rounded hover:opacity-90 transition-all">
                    CREATE FIRST LOCATION
                </button>
            </div>
        }

        @foreach (var quest in _quests)
        {
            <InventoryQuestComponent Quest="@quest" OnQuestUpdated="QuestDataUpdate" />
        }
    }

    @* ══════════════════════════════════════
       VIEW 2: AGGREGATED TOTALS
    ══════════════════════════════════════ *@
    @if (_view == "aggregate")
    {
        @if (!_aggregated.Any())
        {
            <div class="glass-panel rounded-xl p-16 text-center">
                <span class="material-symbols-outlined text-5xl text-on-surface-variant">
                    inventory_2
                </span>
                <p class="text-body text-on-surface-variant mt-4">
                    No items yet. Add items to your locations first.
                </p>
            </div>
        }
        else
        {
            @* Search bar *@
            <div class="flex items-center gap-2 glass-panel border border-white/10 rounded-xl px-4 py-3">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
                <input @bind="_aggregateSearch" @bind:event="oninput"
                       placeholder="Search all items..."
                       class="bg-transparent text-on-surface text-body w-full
                outline-none placeholder:text-on-surface-variant" />
            </div>

            <div class="glass-panel rounded-xl overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container-highest/50 border-b border-white/5">
                        <tr>
                            <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                COMPONENT
                            </th>
                            <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                TYPE
                            </th>
                            <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                TOTAL QTY
                            </th>
                            <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                LOCATIONS
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agg in FilteredAggregated)
                        {
                            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                                <td class="px-5 py-3">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(agg.ComponentImageUrl))
                                        {
                                            <img src="@agg.ComponentImageUrl"
                                                 class="w-8 h-8 rounded object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 rounded bg-surface-container
                                                flex items-center justify-center">
                                                <span class="material-symbols-outlined text-on-surface-variant text-sm">
                                                    category
                                                </span>
                                            </div>
                                        }
                                        <span class="font-body text-on-surface">@agg.ComponentName</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3">
                                    <span class="text-[10px] font-label-caps px-2 py-0.5 rounded-full
                                        bg-surface-container text-on-surface-variant">
                                        @agg.ComponentType
                                    </span>
                                </td>
                                <td class="px-5 py-3">
                                    <span class="font-data-mono text-data-mono text-primary">
                                        @agg.TotalQuantity
                                    </span>
                                </td>
                                <td class="px-5 py-3">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var loc in agg.Locations)
                                        {
                                            <span class="text-[10px] font-label-caps px-2 py-0.5 rounded-full
                                                bg-primary/10 text-primary border border-primary/20">
                                                @loc.QuestName · @loc.Quantity
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>
                     