@using Microsoft.AspNetCore.Components.Authorization
@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Application.Services.Auth
@inherits LayoutComponentBase

@* Required MudBlazor providers — keep these *@
<MudThemeProvider DefaultScrollbar="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="bg-background text-on-surface font-body min-h-screen overflow-x-hidden">

    @* ── TOP NAV BAR ── *@
    <header class="fixed top-0 left-0 w-full z-40 flex justify-between items-center px-8 h-16
        bg-surface-container-low/80 backdrop-blur-xl border-b border-white/5 shadow-sm">

        <div class="flex items-center gap-8">
            <span class="text-h3 font-h3 font-bold tracking-tighter text-primary">
                RESOURCE_CORE // ALPHA-V1
            </span>
        </div>

        <div class="flex items-center gap-4">
            @if (IsAuthenticated)
            {
                <span class="text-on-surface-variant text-sm hidden md:block">Hello, @Name</span>

                <MudMenu>
                    <ActivatorContent>
                        <div @onclick="@context.ToggleAsync"
                             class="w-9 h-9 rounded-full bg-primary/20 border border-primary/40
                            flex items-center justify-center cursor-pointer
                            hover:bg-primary/30 transition-colors">
                            <span class="material-symbols-outlined text-primary text-xl">person</span>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Label="Logout" OnClick="Logout" />
                    </ChildContent>
                </MudMenu>
            }
            else
            {
                <a href="/login"
                       class="font-label-caps text-label-caps text-primary border border-primary/40
                    px-4 py-2 rounded hover:bg-primary/10 transition-colors">
                    LOGIN
                </a>
            }
        </div>
    </header>

    @* ── BODY: SIDEBAR + CONTENT ── *@
    <div class="flex pt-16 relative">

        @* Sidebar — rendered by NavMenu *@
        <NavMenu IsAuthenticated="IsAuthenticated" />

        @* Main content wrapper *@
        <main class="flex-1 w-full lg:flex-1 p-8 pb-24 lg:pb-8 min-h-[calc(100vh-64px)] overflow-y-auto relative z-0">
            <div class="max-w-7xl mx-auto">
                @Body
            </div>
        </main>

    </div>

    @* ── MOBILE BOTTOM NAV ── *@
    <nav class="lg:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center
        px-6 pb-6 pt-2 bg-surface-container-highest/95 backdrop-blur-md
        border-t border-white/10 shadow-lg">
        <a href="/" class="flex flex-col items-center text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">home</span>
            <span class="font-label-caps text-label-caps mt-1">Home</span>
        </a>
        @if (IsAuthenticated)
        {
            <a href="/admin/game" class="flex flex-col items-center text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">sports_esports</span>
                <span class="font-label-caps text-label-caps mt-1">Game</span>
            </a>
            <a href="/admin/component" class="flex flex-col items-center text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">precision_manufacturing</span>
                <span class="font-label-caps text-label-caps mt-1">Parts</span>
            </a>
            <a href="/admin/recipe" class="flex flex-col items-center text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined">science</span>
                <span class="font-label-caps text-label-caps mt-1">Recipes</span>
            </a>
        }
    </nav>

</div>

@code {
    [Inject] private ICurrentUserService _userService { get; set; }
    [Inject] private NavigationManager _navigation { get; set; }
    [Inject] private JwtAuthStateProvider _authProvider { get; set; }

    private bool IsAuthenticated { get; set; } = false;
    private string Name { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await UpdateUserStateAsync();
        _authProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await UpdateUserStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateUserStateAsync()
    {
        IsAuthenticated = await _userService.GetUserAuthenticaticationStatus();
        Name = IsAuthenticated ? await _userService.GetUserNameAsync() : string.Empty;
    }

    private async Task Logout()
    {
        await _authProvider.MarkUserAsLoggedOutAsync();
        _navigation.NavigateTo("/");
    }
}