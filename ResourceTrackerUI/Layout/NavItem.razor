@* NavItem.razor *@
<a href="@Href"
       class="@GetClass() flex items-center gap-4 px-6 py-3
    hover:bg-white/5 hover:text-primary hover:translate-x-1
    transition-all duration-150 cursor-pointer group">
    <span class="material-symbols-outlined">@Icon</span>
    <span class="font-label-caps text-label-caps">@Label</span>
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Icon { get; set; } = "circle";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string CurrentPath { get; set; } = "";

    private bool IsActive => Href == "/"
        ? CurrentPath == "" || CurrentPath == "/"
        : CurrentPath.StartsWith(Href.TrimStart('/'));

    private string GetClass() => IsActive
        ? "bg-primary-container/20 text-primary border-l-4 border-primary"
        : "text-on-surface-variant border-l-4 border-transparent";
}