
<MudPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <MudNavMenu Class="mud-width-full" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="px-4">Resource Tracker</MudText>
        <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Welcome</MudText>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
        @if(IsAuthenticated)
        {
            <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                <MudNavLink Href="/admin/game" Icon="@Icons.Material.Filled.Games" IconColor="Color.Success">Game</MudNavLink>
                <MudNavLink Href="/admin/component" Icon="@Icons.Material.Filled.PrecisionManufacturing" IconColor="Color.Info">Components</MudNavLink>
                <MudNavLink Href="/admin/recipe" Icon="@Icons.Material.Filled.Science" IconColor="Color.Info">Recipes</MudNavLink>
            </MudNavGroup>
        }

    </MudNavMenu>
</MudPaper>
@code {

    [Parameter]
    public bool IsAuthenticated { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
