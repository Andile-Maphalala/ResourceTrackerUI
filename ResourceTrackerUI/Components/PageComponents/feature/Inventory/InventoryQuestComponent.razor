@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Domain.Enums
@using ResourceTrackerUI.Domain.Models.Feature.Inventory
@using ResourceTrackerUI.Domain.Models.Feature.Quest
<div class="glass-panel rounded-xl overflow-hidden">

    @* Location header *@
    <div class="flex _items-center gap-4 p-5 cursor-pointer hover:bg-white/5 transition-colors
        @(_isExpanded ? "border-b border-white/5" : "")"
         @onclick="() => ToggleQuest()">

        <div class="flex-1 min-w-0">
            <div class="flex _items-center gap-3">
                <p class="font-bold text-on-surface">@Quest.Name</p>
                @if (!string.IsNullOrEmpty(Quest.Location))
                {
                    <span class="text-[10px] font-label-caps text-on-surface-variant
                        bg-surface-container px-2 py-0.5 rounded-full">
                        @Quest.Location
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Quest.Description))
            {
                <p class="text-body-sm text-on-surface-variant truncate">
                    @Quest.Description
                </p>
            }
        </div>

        @* Item count badge *@
        @if (_items != null)
        {
            <span class="text-body-sm text-on-surface-variant mr-2">
                @_items.Count item@(_items.Count != 1 ? "s" : "")
            </span>
        }

        @* Edit/delete actions *@
        <div class="flex _items-center gap-1 mr-2" @onclick:stopPropagation="true">
            <button @onclick="() => OpenEditQuestModal()"
                    class="p-1.5 text-on-surface-variant hover:text-primary
                rounded hover:bg-white/5 transition-colors">
                <span class="material-symbols-outlined text-sm">edit</span>
            </button>
            <button @onclick="() => OpenDeleteQuestModal()"
                    class="p-1.5 text-on-surface-variant hover:text-error
                rounded hover:bg-white/5 transition-colors">
                <span class="material-symbols-outlined text-sm">delete</span>
            </button>
        </div>

        <span class="material-symbols-outlined text-on-surface-variant transition-transform duration-200
            @(_isExpanded ? "rotate-180" : "")">
            expand_more
        </span>
    </div>

    @* Items list *@
    @if (_isExpanded)
    {
        <div class="p-5">
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else
            {
                @* Search within location *@
                <div class="flex _items-center gap-3 mb-4">
                    <div class="flex-1 flex _items-center gap-2 bg-surface-container
                        border border-white/10 rounded-lg px-3 py-2">
                        <span class="material-symbols-outlined text-on-surface-variant text-sm">
                            search
                        </span>
                        <input @bind="_search"
                               @bind:event="oninput"
                               placeholder="Search items..."
                               class="bg-transparent text-on-surface text-body w-full
                        outline-none placeholder:text-on-surface-variant" />
                    </div>
                    <button @onclick="() => OpenAddItemModal()"
                            class="flex _items-center gap-2 px-4 py-2 border border-primary/30
                        text-primary font-label-caps text-label-caps rounded-lg
                        hover:bg-primary/10 transition-colors flex-shrink-0">
                        <span class="material-symbols-outlined text-sm">add</span>
                        ADD ITEM
                    </button>
                </div>

                @* Items table *@
                @if (_items == null || !_items.Any())
                {
                    <div class="text-center py-8 text-on-surface-variant">
                        <span class="material-symbols-outlined text-3xl">inventory_2</span>
                        <p class="text-body-sm mt-2">No items here yet.</p>
                    </div>
                }
                else
                {
                    var filtered = FilterItems();
                    <div class="glass-panel rounded-xl overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-surface-container-highest/50 border-b border-white/5">
                                <tr>
                                    <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                        COMPONENT
                                    </th>
                                    <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                        TYPE
                                    </th>
                                    <th class="px-5 py-3 font-label-caps text-label-caps text-on-surface-variant">
                                        QUANTITY
                                    </th>
                                    <th class="px-5 py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in filtered)
                                {
                                    <tr class="border-b border-white/5 hover:bg-white/5 transition-colors group">
                                        <td class="px-5 py-3">
                                            <div class="flex _items-center gap-3">
                                                @if (!string.IsNullOrEmpty(item.ComponentImageUrl))
                                                {
                                                    <img src="@item.ComponentImageUrl"
                                                         class="w-8 h-8 rounded object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded bg-surface-container
                                                        flex _items-center justify-center">
                                                        <span class="material-symbols-outlined text-on-surface-variant text-sm">
                                                            category
                                                        </span>
                                                    </div>
                                                }
                                                <span class="font-body text-on-surface">
                                                    @item.ComponentName
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-5 py-3">
                                            <span class="text-[10px] font-label-caps px-2 py-0.5 rounded-full
                                                bg-surface-container text-on-surface-variant">
                                                @item.ComponentTypeName
                                            </span>
                                        </td>
                                        <td class="px-5 py-3">
                                            @* Inline quantity editor *@
                                            <div class="flex _items-center gap-2">
                                                <button @onclick="() => DecrementQuantity(item)"
                                                        class="w-6 h-6 rounded bg-surface-container
                                                    text-on-surface-variant hover:text-primary
                                                    hover:bg-primary/10 transition-colors
                                                    flex _items-center justify-center">
                                                    <span class="material-symbols-outlined text-sm">remove</span>
                                                </button>
                                                <span class="font-data-mono text-data-mono text-primary w-8 text-center">
                                                    @item.AmountAquired
                                                </span>
                                                <button @onclick="() => IncrementQuantity(item)"
                                                        class="w-6 h-6 rounded bg-surface-container
                                                    text-on-surface-variant hover:text-primary
                                                    hover:bg-primary/10 transition-colors
                                                    flex _items-center justify-center">
                                                    <span class="material-symbols-outlined text-sm">add</span>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="px-5 py-3 text-right">
                                            <div class="flex _items-center justify-end gap-1
                                                opacity-0 group-hover:opacity-100 transition-opacity">
                                                <button @onclick="() => OpenEditItemModal(item)"
                                                        class="p-1 text-on-surface-variant hover:text-primary
                                                    rounded transition-colors">
                                                    <span class="material-symbols-outlined text-sm">edit</span>
                                                </button>
                                                <button @onclick="() => OpenDeleteItemModal(item)"
                                                        class="p-1 text-on-surface-variant hover:text-error
                                                    rounded transition-colors">
                                                    <span class="material-symbols-outlined text-sm">delete</span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }
</div>

@code {

    [Inject] 
    private IDialogService DialogService { get; set; }

    [Inject] 
    private IInventoryService InventoryService { get; set; }

    [Inject] 
    private IQuestService QuestService { get; set; }

    [Parameter]
    public SearchQuestsResponseModel Quest { get; set; }

    [Parameter]
    public EventCallback<QuestUpdatedModel> OnQuestUpdated { get; set; }

    private List<SearchInventoryResponseModel> _items { get; set; } = new List<SearchInventoryResponseModel>();
    private bool _isExpanded { get; set; } = false;
    private bool _isLoading { get; set; } = true;
    private string _search { get; set; } = string.Empty;
    private QuestUpdateTypeEnum _updateType { get; set; } = QuestUpdateTypeEnum.InitiatedQuestItems;
    protected override async Task OnInitializedAsync()
    {
        await LoadItemsForQuest();
    }

    private async Task IncrementQuantity(SearchInventoryResponseModel item)
    {
        item.AmountAquired++;
        await SaveQuantity(item);
    }

    private async Task DecrementQuantity(SearchInventoryResponseModel item)
    {
        if (item.AmountAquired <= 0) return;
        item.AmountAquired--;
        await SaveQuantity(item);
    }

    private async Task SaveQuantity(SearchInventoryResponseModel item)
    {
        var model = new InventoryCrudModel
        {
            Id = item.Id,
            ComponentId = item.ComponentId,
            AmountAquired = item.AmountAquired
        };
        await InventoryService.UpdateInventory(model, appCancellation.Token);
        await QuestDataUpdate();
        StateHasChanged();
    }

    private async Task ToggleQuest()
    {
        _isExpanded = !_isExpanded;
    }

    private async Task LoadItemsForQuest()
    {
        _isLoading = true;
        StateHasChanged();

        var response = await InventoryService.SearchInventory(new SearchInventoryQueryModel
        {
            QuestId = Quest.Id,
            PageSize = int.MaxValue,
            OrderBy = "ComponentName"
        }, appCancellation.Token);

        _items = response.Data.ToList();
        await QuestDataUpdate();
        _isLoading = false;
    }

    private Task OpenCreateQuestModal() => OpenQuestModal(FormModeEnum.Create);
    private Task OpenEditQuestModal() => OpenQuestModal( FormModeEnum.Update);
    private Task OpenDeleteQuestModal() => OpenQuestModal( FormModeEnum.Delete);

    private async Task OpenQuestModal( FormModeEnum mode)
    {
        var model =  new QuestModel { 
            Id = Quest.Id,
            Description = Quest.Description,
            GameSaveId = Quest.GameSaveId,
            Location = Quest.Location,
            Name = Quest.Name,
            ImageUrl = Quest.ImageUrl
        };

        var parameters = new DialogParameters<EditQuestModal>
            {
                { x => x.Model, model },
                { x => x.FormMode, mode }
            };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditQuestModal>(mode.ToString(), parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (mode == FormModeEnum.Delete)
            {
                _updateType = QuestUpdateTypeEnum.QuestDeleted;
                await QuestDataUpdate();
                
            }
            else
            {
                var updatedQuest = result.Data as QuestModel;
                if(updatedQuest != null)
                {
                    Quest = new SearchQuestsResponseModel
                    {
                        Id = updatedQuest.Id,
                        Description = updatedQuest.Description,
                        GameSaveId = updatedQuest.GameSaveId,
                        Location = updatedQuest.Location,
                        Name = updatedQuest.Name,
                        ImageUrl = updatedQuest.ImageUrl
                    };
                }
            }
            StateHasChanged();

        }
    }

    private List<SearchInventoryResponseModel> FilterItems()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return _items;
        }
        return _items.Where(x => x.ComponentName.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private Task OpenAddItemModal() => OpenItemModal(null, FormModeEnum.Create);

    private Task OpenEditItemModal(SearchInventoryResponseModel item) => OpenItemModal(item, FormModeEnum.Update);

    private Task OpenDeleteItemModal(SearchInventoryResponseModel item) => OpenItemModal(item, FormModeEnum.Delete);

    private async Task OpenItemModal(SearchInventoryResponseModel? item, FormModeEnum mode)
    {

        var model = new InventoryModel { QuestId = Quest!.Id };
        if (item != null)
        {
            model = new InventoryModel
            {
                QuestId = Quest!.Id,
                ComponentId = item.ComponentId,
                AmountAquired = item.AmountAquired,
                ComponentImageUrl = item.ComponentImageUrl,
                ComponentName = item.ComponentName,
                ComponentType = item.ComponentType,
                Id = item.Id
            };
        }
        var parameters = new DialogParameters<EditInventoryItemModal>
            {
                { x => x.Model, model },
                { x => x.FormMode, mode }
            };

        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditInventoryItemModal>(mode.ToString(), parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            _updateType = QuestUpdateTypeEnum.ItemsUpdated;
            await QuestDataUpdate();
            await LoadItemsForQuest();
            StateHasChanged();
        }
    }

    private async Task QuestDataUpdate()
    {
        if (OnQuestUpdated.HasDelegate)
        {
            await OnQuestUpdated.InvokeAsync(new QuestUpdatedModel
            {
                QuestId = Quest.Id,
                Items = _items,
                UpdateType = _updateType
            });
        }
    }
    
}
