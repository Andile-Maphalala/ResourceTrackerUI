@using ResourceTrackerUI.Components.CustomComponents.FormData
@using ResourceTrackerUI.Domain.Models.Feature.Quest

<RtForm TModel="QuestModel" Model="Model" FormMode="FormMode" OnSubmit="Submit" OnCancel="Cancel">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <RtInput @bind-Value="Model.Name" For="@(() => Model.Name)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <RtInput @bind-Value="Model.Location" For="@(() => Model.Location)" />
        </MudItem>
        <MudItem xs="12">
            <RtInput @bind-Value="Model.Description" For="@(() => Model.Description)"
                     Lines="3" MaxLines="5" />
        </MudItem>
    </MudGrid>
</RtForm>


