@using ResourceTrackerUI.Application.Interfaces
@using ResourceTrackerUI.Components.CustomComponents
@using ResourceTrackerUI.Domain.Enums
@using ResourceTrackerUI.Domain.Models.Feature
@using System.Text.Json
@using ResourceTrackerUI.Domain.Models.Feature.Game


<RtForm TModel="GameModel" Model="Model" FormMode="FormMode" OnSubmit="Submit" OnCancel="Cancel">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <RtInput @bind-Value="Model.Name" For="@(() => Model.Name)"/>
            <RtInput @bind-Value="Model.AltText"
                          For="@(() => Model.AltText)"
                          Disabled = "@(FormMode != FormModeEnum.Create)"/>
        </MudItem>
        <MudItem xs="12" sm="6">
            <RtInput @bind-Value="Model.Description"
                          For="@(() => Model.Description)"
                          Counter="225"
                          MaxLines="10"
                          Lines="5" 
                          /> 
        </MudItem>

        <MudItem xs="12" sm="12">
            <MudGrid>
                <MudItem xs="12" sm="9">
                    @if (FormMode == FormModeEnum.Create)
                    {
                        <MudImage Src="@Base64"
                                  Alt="@Model.AltText"
                                  Height="400"
                                  Width="400"
                                  Elevation="25"
                                  Class="rounded-lg"
                                  ObjectFit="@ObjectFit.ScaleDown" />
                    }
                    else if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <MudImage Src="@Model.ImageUrl"
                                  Alt="@Model.AltText"
                                  Height="400"
                                  Width="400"
                                  Elevation="25"
                                  Class="rounded-lg"
                                  ObjectFit="@ObjectFit.ScaleDown" />
                    }

                </MudItem>
                <MudItem xs="12" sm="3">
                    @if (FormMode == FormModeEnum.Create)
                    {
                        <MudFileUpload @bind-Files="@Model.Image"
                                       OnFilesChanged="@SwapPicture"
                                       Accept=".jpg,.bmp,.tiff,.jpeg,.png">
                        </MudFileUpload>
                    }
                   
                </MudItem>
            </MudGrid>
        </MudItem>

    </MudGrid>
</RtForm>


