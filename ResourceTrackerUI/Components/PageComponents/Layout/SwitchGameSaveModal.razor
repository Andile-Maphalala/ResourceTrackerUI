@using ResourceTrackerUI.Components.CustomComponents.FormData
@using ResourceTrackerUI.Domain.Models.Feature.Game
@using ResourceTrackerUI.Domain.Models.Feature.GameSave

<RtDialog Title="@(_step == 1 ? "Select Game" : $"Select Save — {_selectedGame.Name}")">
    <ChildContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">

            @* ── STEP 1: Game picker ── *@
            @if (_step == 1)
            {
                <RtInput T="string" Value="_searchString" OnValueChangedData="OnGameSearch" Label="Search" />

                <MudGrid Class="mt-4" Spacing="2">
                    @foreach (var game in _games)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Style="cursor:pointer; height:100%;"
                                     @onclick="() => SelectGame(game)">
                                <MudCardMedia Image="@game.ImageUrl" Height="120" />
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@game.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @game.Description
                                    </MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => SelectGame(game)">
                                        Select
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }

                    @if (!_games.Any() && !_isLoading)
                    {
                        <MudItem xs="12">
                            <MudText Color="Color.Secondary" Class="text-center py-8">
                                No games found.
                            </MudText>
                        </MudItem>
                    }
                </MudGrid>
            }

            @* ── STEP 2: Save picker ── *@
            @if (_step == 2)
            {
                @if (_isLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var save in _saves)
                        {
                            var isActive = save.Id == CurrentSaveId;
                            <MudItem xs="12" sm="6">
                                <MudCard Class="@(isActive ? "border border-primary" : "")"
                                         Style="cursor:pointer; height:100%;"
                                         @onclick="() => ConfirmSave(save)">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-center">
                                            <div>
                                                <MudText Typo="Typo.h6">@save.Name</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    Created: @save.Created.ToShortDateString()
                                                </MudText>
                                                @if (!string.IsNullOrEmpty(save.Description))
                                                {
                                                    <MudText Typo="Typo.body2" Class="mt-1">
                                                        @save.Description
                                                    </MudText>
                                                }
                                            </div>
                                            @if (isActive)
                                            {
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                                    Active
                                                </MudChip>
                                            }
                                        </div>
                                    </MudCardContent>
                                    <MudCardActions>
                                        @if (!isActive)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => ConfirmSave(save)">
                                                Switch to this
                                            </MudButton>
                                        }
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }

                        @if (!_saves.Any())
                        {
                            <MudItem xs="12">
                                <MudText Color="Color.Secondary" Class="text-center py-8">
                                    No saves found for this game.
                                </MudText>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }

        </MudContainer>
    </ChildContent>

    <ActionContent>
        @if (_step == 2)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Back
            </MudButton>
        }

        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/gamesave">
            New Save
        </MudButton>
    </ActionContent>
</RtDialog>